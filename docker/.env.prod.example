# PRODUÇÃO — copiar para .env neste diretório na VPS e preencher.
# NUNCA commitar o .env. Gerar segredos com: openssl rand -base64 48

# --- Domínio público (DNS A apontando p/ o IP da VPS) ---
DOMINIO=revisional.mpgsistemas.tec.br
# Porta externa do HTTPS (host compartilhado: 8090 externa → 443 do container)
PORTA_EXTERNA=8090

# --- PostgreSQL ---
POSTGRES_DB=revisional_db
POSTGRES_USER=revisional
POSTGRES_PASSWORD=troque-por-senha-forte

# --- Segredos da aplicação ---
JWT_SECRET=troque-por-segredo-forte
CONFIG_ENC_SECRET=troque-por-outro-segredo-forte

# --- MinIO (documentos anexados) ---
MINIO_ROOT_USER=revisional
MINIO_ROOT_PASSWORD=troque-por-senha-forte
MINIO_BUCKET=revisional-docs

# --- Admin da plataforma (SUPER_ADMIN, criado no 1º boot) ---
APP_ADMIN_TENANT=MPG Sistemas
APP_ADMIN_CPF=00000000000
APP_ADMIN_EMAIL=suporte@mpgsistemas.com.br
APP_ADMIN_OAB=ADMIN-0001
APP_ADMIN_SENHA=troque-no-primeiro-login

# --- IA global (opcional; tenants configuram a própria chave em /parametros) ---
OPENROUTER_API_KEY=
